{
  // Coverage and intentional lint exclusions are documented in biome-rules.jsonc.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["bun"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*.js", "bin/**/*.js", "skills/axstack/scripts/**/*.js"]
}
