{
  "name": "axstack",
  "version": "0.34.0",
  "description": "Axstack installer and setup CLI: installs owned chat skills and role data, configures supported harness settings, and checks T3 Code capabilities.",
  "keywords": [
    "claude-code",
    "codex",
    "t3-code",
    "agents",
    "skills",
    "orchestration"
  ],
  "homepage": "https://github.com/axatbhardwaj/axstack#readme",
  "bugs": "https://github.com/axatbhardwaj/axstack/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axatbhardwaj/axstack.git"
  },
  "author": "Axat Bhardwaj",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "bin": {
    "axstack": "bin/axstack.js"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "profiles/",
    "docs/*.md"
  ],
  "scripts": {
    "lint": "biome lint . --error-on-warnings",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit --project jsconfig.json",
    "test": "bun test",
    "test:all": "bun test"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
