      "expected": { "reviewers": ["axstack-reviewer-secondary: claude/claude-opus-5 medium"], "coverage": "all six angles and acceptance against exact SHA A and base SHA B" }
    },
    {
      "id": "mixed-opus-authored",
      "input": { "preset": "mixed", "mode": "authored", "actualAuthor": "claude/claude-opus-5 medium", "candidate": "SHA C", "base": "SHA D" },
      "expected": { "reviewers": ["axstack-reviewer-primary: codex/gpt-5.6-sol medium"], "coverage": "all six angles and acceptance against exact SHA C and base SHA D" }
    },
    {
      "id": "codex-sol-authored",
      "input": { "preset": "codex-only", "mode": "authored", "actualAuthor": "codex/gpt-5.6-sol medium", "candidate": "SHA E", "base": "SHA F" },
      "expected": { "reviewers": ["axstack-reviewer-secondary: codex/gpt-5.6-terra xhigh"], "independence": "different model, not cross-provider" }
    },
    {
      "id": "claude-opus-authored",
      "input": { "preset": "claude-only", "mode": "authored", "actualAuthor": "claude/claude-opus-5 medium", "candidate": "SHA G", "base": "SHA H" },
      "expected": { "reviewers": ["axstack-reviewer-secondary: claude/claude-sonnet-5 xhigh"], "independence": "different model, not cross-provider" }
    },
    {
