      "expected": { "status": "INCOMPLETE", "action": "ask user for explicit routing", "forbidden": ["reverse route to axstack-reviewer-primary", "infer pairing from slot position"] }
    },
    {
      "id": "claude-sonnet-authored-unsupported",
      "input": { "preset": "claude-only", "mode": "authored", "actualAuthor": "claude/claude-sonnet-5", "candidate": "SHA G2", "base": "SHA H2" },
      "expected": { "status": "INCOMPLETE", "action": "ask user for explicit routing", "forbidden": ["reverse route to axstack-reviewer-primary", "infer pairing from slot position"] }
    },
    {
