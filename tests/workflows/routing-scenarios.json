    {
      "id": "active-run-preset-switch",
      "input": { "recordedPreset": "mixed", "recordedSnapshot": "role/model/effort snapshot S", "newSelectedPreset": "codex-only", "runState": "active" },
      "expected": { "activeRun": "keep snapshot S", "newRuns": "use codex-only", "forbidden": ["replace active sessions", "silently migrate active run"] }
    },
    {
      "id": "claude-sonnet-explanation-exception",
      "input": { "preset": "claude-only", "artifact": "explanation", "author": "axstack-explainer Sonnet xhigh", "reviewer": "axstack-explainer-review Sonnet high" },
      "expected": { "allowed": "separate-session explanation review", "independence": "session independence only", "forbidden": ["cross-provider claim", "same-model code review"] }
    },
    {
      "id": "single-provider-high-stakes-unmapped",
      "input": { "preset": "claude-only", "work": "high-stakes code change", "availableMapping": "none" },
      "expected": { "status": "HOLD", "action": "pause for explicit user decision", "forbidden": ["borrow mixed routing", "invent same-provider mapping", "change effort silently"] }
