      "input": { "preset": "mixed", "mode": "peer", "actualAuthor": "external author", "candidate": "SHA I", "base": "SHA J" },
      "expected": { "reviewers": ["axstack-reviewer-primary: codex/gpt-5.6-sol medium", "axstack-reviewer-secondary: claude/claude-opus-5 medium"], "rules": ["identical complete briefs", "isolated first passes", "neither reviewer is author or owner", "cross-provider independence"] }
    },
    {
      "id": "codex-peer",
      "input": { "preset": "codex-only", "mode": "peer", "actualAuthor": "external author", "candidate": "SHA K", "base": "SHA L" },
      "expected": { "reviewers": ["axstack-reviewer-primary: codex/gpt-5.6-sol medium", "axstack-reviewer-secondary: codex/gpt-5.6-terra xhigh"], "rules": ["identical complete briefs", "isolated first passes", "different-model independence only"] }
    },
    {
      "id": "claude-peer",
      "input": { "preset": "claude-only", "mode": "peer", "actualAuthor": "external author", "candidate": "SHA M", "base": "SHA N" },
      "expected": { "reviewers": ["axstack-reviewer-primary: claude/claude-opus-5 medium", "axstack-reviewer-secondary: claude/claude-sonnet-5 xhigh"], "rules": ["identical complete briefs", "isolated first passes", "different-model independence only"] }
    },
    {
      "id": "unknown-author-provenance",
      "input": { "preset": "mixed", "mode": "authored", "actualAuthor": "unknown or unsupported", "candidate": "SHA O", "base": "SHA P" },
      "expected": { "status": "INCOMPLETE", "action": "ask user for explicit routing", "forbidden": ["infer provenance from owner or driver", "invent reverse pairing"] }
    },
    {
      "id": "owner-authored-candidate",
      "input": { "preset": "mixed", "mode": "authored", "owner": "claude/claude-opus-5 medium", "actualWriter": "same owner session", "candidate": "SHA Q", "base": "SHA R" },
