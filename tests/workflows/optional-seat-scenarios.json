    },
    {
      "id": "mixed-provider-loss",
      "input": { "preset": "mixed", "fanout": "code research", "solPair": "launch failure", "otherCodexSeat": "none" },
      "expected": { "status": "HOLD affected fan-out", "reason": "Mixed fan-out would have no Codex seat", "forbidden": ["substitute model", "claim mixed coverage"] }
    },
    {
      "id": "required-adviser-outage",
      "input": { "phase": "Align", "adviser": "Astra", "launch": "unavailable" },
      "expected": { "status": "HOLD Align", "forbidden": ["mark adviser optional", "substitute provider"] }
    },
    {
      "id": "required-fable-outage",
      "input": { "phase": "high-stakes", "seat": "Fable", "launch": "unavailable" },
      "expected": { "status": "HOLD decision", "forbidden": ["skip Fable", "substitute provider"] }
    },
    {
      "id": "model-null-required",
      "input": { "preset": "codex-only", "phase": "Align", "role": "axstack-advisor-opus", "model": null },
      "expected": { "status": "HOLD Align", "forbidden": ["treat as optional absence", "substitute role"] }
    },
    {
      "id": "auditor-unlaunchable",
      "input": { "phase": "Close-out", "auditor": "preflight rejected", "dispatchStarted": false, "attemptedRoute": "claude/sonnet high", "error": "profile unavailable" },
      "expected": { "action": "Archive with auditor: UNKNOWN (unlaunchable), attempted route and error", "forbidden": ["substitute auditor", "claim audit PASS"] }
    },
    {
      "id": "auditor-launched",
      "input": { "phase": "Close-out", "auditor": "Dispatch started then failed" },
      "expected": { "status": "HOLD until launched Dispatch settles", "forbidden": ["use unlaunchable archive exception"] }
