      "expected": { "action": "Dispatch Sonnet and Sol independently from the same brief", "forbidden": ["skip Sol", "substitute another role"] }
    },
    {
      "id": "optional-absent",
      "input": { "preset": "mixed", "fanout": "research", "googleSeat": "trust/login prompt", "otherSeats": "Sonnet code and Sol code launchable" },
